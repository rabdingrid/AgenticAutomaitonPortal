# Copy this file to .env in the same folder and fill in real values.
#   cp .env.example .env
#
# Path: deployment-portal/backend/.env
# Never commit .env (contains secrets).

# ── Microsoft Graph email (submit → approver + CC) — n8n-style delegated OAuth ──
MS_TENANT_ID=your-azure-tenant-id
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-app-client-secret
# One-time sign-in: .venv/bin/python scripts/graph_oauth_login.py
# Or paste refresh token from n8n after connecting Outlook there:
MS_REFRESH_TOKEN=
# Optional label; mail sends as the user who completed OAuth (/me)
MS_SENDER_EMAIL=you@company.com

# URLs embedded in approval emails (use your real hostnames in prod)
PORTAL_BASE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:9002

# Optional: hours before email Approve link expires (default 72)
# MAIL_TOKEN_EXPIRE_HOURS=72

# ── GitSpace live validation (optional) ─────────────────────────────────
# GITSPACE_MODE=live
# GITSPACE_TOKEN=glpat-your-read-api-token

# ── Ollama AI (local; does not need VPN) ──────────────────────────────
# VALIDATION_USE_AI=true
# OLLAMA_MODEL=qwen2.5-coder:7b
# Optional: force the same baseline release folder for all new-vs-old diffs
# VALIDATION_BASELINE_RELEASE=R-2026-06-W3
# Speed tuning (optional):
# VALIDATION_AI_SUMMARY=false          # skip slow markdown briefing; per-check AI still runs
# VALIDATION_AI_SKIP_REDUNDANT_REVIEW=true   # default: skip content-review when diff ran
# OLLAMA_NUM_PREDICT_JSON=384
# OLLAMA_NUM_PREDICT_SUMMARY=700
# DB SQL syntax validation (Liquibase changesets):
# VALIDATION_SQL_DIALECT=mysql          # mysql | tsql | postgres (default mysql)
# VALIDATION_SQL_REQUIRE_SEMICOLON=true # every SQL statement must end with `;`

# ── JWT secret (change in production) ───────────────────────────────────
# JWT_SECRET=change-me-in-production-use-a-long-random-string
